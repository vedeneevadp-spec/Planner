[Unit]
Description=Send Planner backup failure alert for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=planner-alert
Group=planner-alert
WorkingDirectory=/opt/planner/current
EnvironmentFile=/etc/planner/backup-alert-runtime.env
EnvironmentFile=/etc/planner/backup-alert.env
ExecStart=/usr/bin/node /opt/planner/current/scripts/infrastructure-backup-alert.mjs %i
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0077
TimeoutStartSec=30
