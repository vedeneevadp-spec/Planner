[Unit]
Description=Planner Task and Self-Care Reminders Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=planner-worker
Group=planner-worker
SupplementaryGroups=planner-push
WorkingDirectory=/opt/planner/current
EnvironmentFile=/etc/planner/reminders.env
ExecStart=/usr/bin/node /opt/planner/current/apps/api/dist/task-reminders.js
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
