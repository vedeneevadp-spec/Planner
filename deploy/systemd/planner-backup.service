[Unit]
Description=Planner encrypted infrastructure backup
After=network-online.target
Wants=network-online.target
OnFailure=planner-backup-alert@%n.service

[Service]
Type=oneshot
User=planner
Group=planner
WorkingDirectory=/opt/planner/current
EnvironmentFile=/etc/planner/planner.env
EnvironmentFile=/etc/planner/release.env
EnvironmentFile=-/etc/planner/backup.env
Environment=INFRASTRUCTURE_BACKUP_DIR=/opt/planner/shared/backups/infrastructure
Environment=INFRASTRUCTURE_BACKUP_STATUS_PATH=/opt/planner/shared/state/backup-status.json
Environment=RESTIC_CACHE_DIR=/opt/planner/shared/state/restic-cache
Environment=BACKUP_REQUIRE_ASSETS=1
Environment=BACKUP_REQUIRE_OFFSITE=1
ExecStart=/usr/bin/flock -w 300 /opt/planner/shared/state/backup.lock /usr/bin/npm run backup:create
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=2h
