[Unit]
Description=Planner backup retention maintenance
After=network-online.target
Wants=network-online.target
OnFailure=planner-backup-alert@%n.service

[Service]
Type=oneshot
User=planner
Group=planner
WorkingDirectory=/opt/planner/current
EnvironmentFile=/etc/planner/planner.env
EnvironmentFile=-/etc/planner/backup.env
Environment=INFRASTRUCTURE_BACKUP_DIR=/opt/planner/shared/backups/infrastructure
Environment=RESTIC_CACHE_DIR=/opt/planner/shared/state/restic-cache
Environment=BACKUP_REQUIRE_OFFSITE=1
ExecStart=/usr/bin/flock -w 300 /opt/planner/shared/state/backup.lock /usr/bin/npm run backup:prune
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
TimeoutStartSec=4h
