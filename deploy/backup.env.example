# Store the real file at /etc/planner/backup.env with mode 0600.
# The offsite repository should be outside the production VPS failure domain.
RESTIC_REPOSITORY=s3:https://object-storage.example.test/planner-backups
RESTIC_PASSWORD_FILE=/etc/planner/restic-password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# Configure either a generic JSON webhook or both Telegram values.
BACKUP_ALERT_WEBHOOK_URL=https://alerts.example.test/hooks/planner-backup
BACKUP_ALERT_TELEGRAM_BOT_TOKEN=
BACKUP_ALERT_TELEGRAM_CHAT_ID=

# Prefer a dedicated read-only backup role over the migration owner role.
BACKUP_DATABASE_URL=postgres://planner_backup:replace-me@db.example.test/planner

RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
BACKUP_LOCAL_KEEP_DAYS=14

# This must point to an isolated PostgreSQL cluster or recovery environment.
RESTORE_DRILL_ADMIN_DATABASE_URL=postgres://planner_drill:replace-me@recovery-db.example.test/postgres
